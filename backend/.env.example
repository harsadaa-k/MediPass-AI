# MediPass Backend — Environment Variables
# Copy this file to .env and fill in real values.

# Google Gemini API key (required — no default)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Gemini model used for every AI call (default: gemini-3.6-flash)
# MEDIPASS_GEMINI_MODEL=gemini-3.6-flash

# Optional: backup models tried when the main one is overloaded (503), out of
# quota (429) or unavailable (404). Comma-separated; empty disables.
# MEDIPASS_GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite

# SMTP email settings (optional — emails are logged to console if unset)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# JWT signing secret (required in production; falls back to a dev default only when MEDIPASS_ENV=development)
MEDIPASS_SECRET_KEY=change-me-to-a-random-string

# Database URL (default: SQLite file in the backend directory)
MEDIPASS_DATABASE_URL=sqlite:///./medipass.db

# Upload directory for documents (default: ./uploads)
MEDIPASS_UPLOAD_DIR=./uploads

# Set to "true" to skip email verification on login (useful for demos)
MEDIPASS_SKIP_EMAIL_VERIFICATION=false

# Set to "development" to allow the dev-only JWT secret fallback
MEDIPASS_ENV=development

# Optional: full path to tesseract binary (only needed if it's not on PATH)
# TESSERACT_CMD_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# Optional: allowed frontend origins (comma-separated). Default: http://localhost:5173,http://127.0.0.1:5173
# MEDIPASS_CORS_ORIGINS=http://localhost:5173,http://192.168.1.20:5173

# Only verified doctors can add new patients (see docs/DOCTOR_VERIFICATION.md). Set false for quick demos.
# MEDIPASS_REQUIRE_VERIFIED_DOCTORS=true

# Where links in emails point (verification, password reset). Set to the deployed frontend address.
# MEDIPASS_FRONTEND_URL=http://localhost:5173
# Sender name shown in the inbox (the address is SMTP_USERNAME).
# SMTP_FROM_NAME=MediPass

# Create the two demo accounts on startup (their passwords are public). Set false on a public deployment.
# MEDIPASS_SEED_DEMO=true

# Accounts (comma-separated emails) that get the Review doctors screen to approve doctors.
# MEDIPASS_REVIEWER_EMAILS=you@example.com

# Send email through Brevo's HTTPS API instead of SMTP (needed where SMTP is blocked, e.g. Railway trial/hobby).
# BREVO_API_KEY=your-brevo-api-key
# MEDIPASS_EMAIL_FROM=verified-sender@example.com
